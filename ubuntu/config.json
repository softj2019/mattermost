{
  "ServiceSettings": {
    "SiteURL": "http://localhost:8065",
    "ListenAddress": ":8065"
  },
  "SqlSettings": {
    "DriverName": "postgres",
    "DataSource": "postgres://mmuser:mostest@dbhost:5432/mattermost?sslmode=disable&connect_timeout=10",
    "MaxIdleConns": 10,
    "MaxOpenConns": 10,
    "ConnMaxLifetimeMilliseconds": 3600000,
    "QueryTimeout": 30
  },
  "LogSettings": {
    "EnableConsole": true,
    "ConsoleLevel": "INFO",
    "FileLevel": "INFO",
    "EnableFile": true,
    "FileLocation": "/opt/mattermost/logs/mattermost.log"
  }
}
